# Модель Whisper: tiny / base / small / medium / large-v3
WHISPER_MODEL=small

# Устройство: auto (GPU при наличии CUDA, иначе CPU) / cuda / cpu
WHISPER_DEVICE=auto

# Тип вычислений CTranslate2. Пусто = float16 на GPU / int8 на CPU.
# Варианты: float16, int8_float16, int8, float32
# WHISPER_COMPUTE_TYPE=

# Потоки CPU для CPU-режима (пусто = все ядра)
# WHISPER_CPU_THREADS=

# Ширина beam search: 5 — точнее, 1–2 — быстрее
WHISPER_BEAM_SIZE=5

# Язык: ru или auto для автоопределения
WHISPER_LANGUAGE=ru

# Куда качать модель (по умолчанию кеш HuggingFace)
# WHISPER_DOWNLOAD_ROOT=

# Токен Hugging Face — убирает троттлинг анонимных загрузок (быстрее качает
# модели). Получить: https://huggingface.co/settings/tokens (read-доступа хватит).
# HF_TOKEN=

# Gradio
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7861
