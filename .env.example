# Модель Whisper: tiny / base / small / medium / large-v3 / large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# Устройство: auto (GPU при наличии CUDA, иначе CPU) / cuda / cpu
WHISPER_DEVICE=auto

# Тип вычислений CTranslate2. Пусто = float16 на GPU / int8 на CPU.
# Варианты: float16, int8_float16, int8, float32
# WHISPER_COMPUTE_TYPE=

# Потоки CPU для CPU-режима (пусто = все ядра)
# WHISPER_CPU_THREADS=

# Ширина beam search: 5 — точнее, 1–2 — быстрее
WHISPER_BEAM_SIZE=5

# Язык: ru или auto для автоопределения
WHISPER_LANGUAGE=ru

# Куда качать модель (по умолчанию кеш HuggingFace)
# WHISPER_DOWNLOAD_ROOT=

# Токен Hugging Face — убирает троттлинг анонимных загрузок (быстрее качает
# модели). Получить: https://huggingface.co/settings/tokens (read-доступа хватит).
# HF_TOKEN=

# Gradio
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7861

# Защита от выдуманных фраз: тишина длиннее порога (сек) не отдаётся модели. 0 — выкл.
WHISPER_HALLUCINATION_SILENCE=2

# Разделение по говорящим (sherpa-onnx): где хранить модели и порог кластеризации
# (больше — меньше говорящих при автоподборе)
# DIARIZATION_DIR=/app/whisper/diarization
DIARIZATION_THRESHOLD=0.5
# Второй проход: кластеры с похожим отпечатком голоса (сходство не ниже порога)
# склеиваются в одного говорящего. Ниже 0.6 слипаются разные люди. 0 — выкл.
DIARIZATION_MERGE_THRESHOLD=0.6

# Часовой пояс для времени в meta.json и интерфейсе
TZ=Europe/Moscow

# GPU diarization (CPU clustering remains; helper threads are bounded)
DIARIZATION_PROVIDER=cuda
DIARIZATION_NUM_THREADS=2
